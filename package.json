{
  "name": "termi",
  "productName": "Termi",
  "desktopName": "termi.desktop",
  "version": "0.1.5",
  "description": "A terminal for macOS and Linux with saved commands that open several terminals side by side, and auto-start.",
  "main": "out/main/main.js",
  "author": {
    "name": "Webanion",
    "email": "operations@webanion.com",
    "url": "https://webanion.com"
  },
  "license": "MIT",
  "homepage": "https://termi.webanion.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webanion/termi.git"
  },
  "bugs": {
    "url": "https://github.com/webanion/termi/issues"
  },
  "keywords": [
    "terminal",
    "terminal-emulator",
    "electron",
    "xterm",
    "node-pty",
    "mcp",
    "macos",
    "linux"
  ],
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "presmoke": "node node_modules/electron/install.js && npm run build",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "icons": "bash scripts/buildIcons.sh",
    "setup:apparmor": "node scripts/devAppArmor.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.webanion.termi",
    "productName": "Termi",
    "copyright": "Copyright © 2026 Webanion",
    "directories": {
      "buildResources": "assets",
      "output": "_releases/${version}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Development",
      "maintainer": "Webanion <operations@webanion.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true
    },
    "win": {
      "icon": "assets/icon.png"
    }
  }
}
