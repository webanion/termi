{
  "name": "termi",
  "productName": "Termi",
  "version": "0.1.0",
  "description": "A terminal app with a warm dark theme, saved commands, and auto-start.",
  "main": "out/main/main.js",
  "author": "Jawad Ahbab",
  "license": "MIT",
  "homepage": "https://github.com/JawadAhbab/termi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JawadAhbab/termi.git"
  },
  "bugs": {
    "url": "https://github.com/JawadAhbab/termi/issues"
  },
  "keywords": [
    "terminal",
    "terminal-emulator",
    "electron",
    "xterm",
    "node-pty",
    "mcp",
    "macos",
    "linux"
  ],
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "eslint \"{src,tests}/**/*.{ts,tsx}\" electron.vite.config.ts \"vitest*.config.ts\"",
    "lint:fix": "eslint \"{src,tests}/**/*.{ts,tsx}\" electron.vite.config.ts \"vitest*.config.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "presmoke": "node node_modules/electron/install.js && npm run build",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "icons": "bash scripts/buildIcons.sh",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "build": {
    "appId": "work.jawad.termi",
    "productName": "Termi",
    "directories": {
      "buildResources": "assets",
      "output": "_releases/${version}"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "Jawad Ahbab",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "icon": "assets/icon.png"
    }
  }
}
